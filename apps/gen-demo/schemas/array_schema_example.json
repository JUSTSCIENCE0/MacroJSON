                            "dbl_attr": {
                                "title": "Double Attribute",
                                "description": "Double-precision floating-point attribute",
                                "type": "number"
                            },
                            "obj_attr": {
                                "title": "Simple Example",
                                "description": "A simple example object with primitive types and string",
                                "type": "object",
                                "properties": {
                                    "i32_attr": {
                                        "title": "I32 Attribute",
                                        "description": "32-bit integer attribute",
                                        "type": "integer",
                                        "minimum": -2147483648,
                                        "maximum": 2147483647
                                    },
                                    "dbl_attr": {
                                        "title": "Double Attribute",
                                        "description": "Double-precision floating-point attribute",
                                        "type": "number"
                                    },
                                    "u64_attr": {
                                        "title": "U64 Attribute",
                                        "description": "64-bit unsigned integer attribute",
                                        "type": "integer"
                                    },
                                    "str_attr": {
                                        "title": "String Attribute",
                                        "type": "string",
